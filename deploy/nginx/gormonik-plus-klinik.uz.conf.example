# Asosiy domen: gormonik-plus-klinik.uz
# Nginx -> 127.0.0.1:3000 (PM2 yoki Docker)

server {
    listen 80;
    server_name gormonik-plus-klinik.uz www.gormonik-plus-klinik.uz;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# Certbot dan keyin HTTPS blok qo'shing:
# certbot --nginx -d gormonik-plus-klinik.uz -d www.gormonik-plus-klinik.uz
