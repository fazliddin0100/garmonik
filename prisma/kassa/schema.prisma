generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/kassa-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["kassa"]
}

enum UserRole {
  ADMIN
  CASHIER

  @@schema("kassa")
}

enum InvoiceStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  CANCELLED
  REFUNDED

  @@schema("kassa")
}

enum PaymentPlatform {
  CASH
  HUMO
  VISA
  UZCARD
  TERMINAL
  CLICK
  PAYME
  CUSTOM

  @@schema("kassa")
}

enum ExpenseStatus {
  PAID
  PARTIALLY_PAID

  @@schema("kassa")
}

model User {
  id               String    @id @default(cuid())
  login            String    @unique
  passwordHash     String    @map("password_hash")
  fullName         String    @map("full_name")
  role             UserRole  @default(CASHIER)
  isActive         Boolean   @default(true) @map("is_active")
  failedLoginCount Int       @default(0) @map("failed_login_count")
  lockedUntil      DateTime? @map("locked_until")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  invoices        Invoice[]
  invoicePayments InvoicePayment[]
  expensePayments ExpensePayment[]
  expenses        Expense[]
  auditLogs       AuditLog[]

  @@map("users")
  @@schema("kassa")
}

model Patient {
  id                String    @id @default(cuid())
  fullName          String    @map("full_name")
  phone             String?
  birthDate         DateTime? @map("birth_date")
  /// public.patients.id — klinika kartochkasi bilan bog'lanish (Bosqich 2+)
  garmonikPatientId String?   @map("garmonik_patient_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")

  invoices Invoice[]

  @@index([garmonikPatientId])
  @@map("patients")
  @@schema("kassa")
}

model ServiceCategory {
  id        String    @id @default(cuid())
  name      String    @unique
  services  Service[]
  createdAt DateTime  @default(now()) @map("created_at")

  @@map("service_categories")
  @@schema("kassa")
}

model Service {
  id         String   @id @default(cuid())
  name       String
  price      Decimal  @db.Decimal(12, 2)
  categoryId String?  @map("category_id")
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  category     ServiceCategory?      @relation(fields: [categoryId], references: [id])
  priceHistory ServicePriceHistory[]
  invoiceItems InvoiceItem[]

  @@map("services")
  @@schema("kassa")
}

model ServicePriceHistory {
  id        String   @id @default(cuid())
  serviceId String   @map("service_id")
  oldPrice  Decimal  @map("old_price") @db.Decimal(12, 2)
  newPrice  Decimal  @map("new_price") @db.Decimal(12, 2)
  changedBy String?  @map("changed_by")
  createdAt DateTime @default(now()) @map("created_at")

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@map("service_price_history")
  @@schema("kassa")
}

model PaymentType {
  id          String          @id @default(cuid())
  name        String
  platform    PaymentPlatform
  isActive    Boolean         @default(true) @map("is_active")
  sortOrder   Int             @default(0) @map("sort_order")
  gatewayHost String?         @map("gateway_host")
  gatewayPort Int             @default(8080) @map("gateway_port")
  gatewayPath String          @default("/api/payment") @map("gateway_path")

  invoices        Invoice[]
  invoicePayments InvoicePayment[]
  expensePayments ExpensePayment[]
  expenses        Expense[]

  @@map("payment_types")
  @@schema("kassa")
}

model Invoice {
  id            String        @id @default(cuid())
  invoiceNumber Int           @unique @default(autoincrement()) @map("invoice_number")
  patientId     String        @map("patient_id")
  cashierId     String        @map("cashier_id")
  paymentTypeId String        @map("payment_type_id")
  subtotal      Decimal       @db.Decimal(12, 2)
  discount      Decimal       @default(0) @db.Decimal(12, 2)
  total         Decimal       @db.Decimal(12, 2)
  amountPaid    Decimal       @map("amount_paid") @db.Decimal(12, 2)
  balanceDue    Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  changeAmount  Decimal       @default(0) @map("change_amount") @db.Decimal(12, 2)
  referralNote  String?       @map("referral_note")
  status        InvoiceStatus @default(PAID)
  createdAt     DateTime      @default(now()) @map("created_at")

  patient     Patient          @relation(fields: [patientId], references: [id])
  cashier     User             @relation(fields: [cashierId], references: [id])
  paymentType PaymentType      @relation(fields: [paymentTypeId], references: [id])
  items       InvoiceItem[]
  payments    InvoicePayment[]

  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@index([status])
  @@map("invoices")
  @@schema("kassa")
}

model InvoicePayment {
  id            String   @id @default(cuid())
  invoiceId     String   @map("invoice_id")
  cashierId     String   @map("cashier_id")
  paymentTypeId String   @map("payment_type_id")
  amount        Decimal  @db.Decimal(12, 2)
  changeAmount  Decimal  @default(0) @map("change_amount") @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  invoice     Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  cashier     User        @relation(fields: [cashierId], references: [id])
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])

  @@index([invoiceId, createdAt])
  @@index([cashierId, createdAt])
  @@index([createdAt])
  @@map("invoice_payments")
  @@schema("kassa")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String  @map("invoice_id")
  serviceId   String  @map("service_id")
  customLabel String? @map("custom_label")
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("invoice_items")
  @@schema("kassa")
}

model Expense {
  id             String        @id @default(cuid())
  category       String
  categoryDetail String?       @map("category_detail")
  amount         Decimal       @db.Decimal(12, 2)
  amountPaid     Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue     Decimal       @default(0) @map("balance_due") @db.Decimal(12, 2)
  payeeName      String?       @map("payee_name")
  status         ExpenseStatus @default(PAID)
  description    String?
  date           DateTime      @db.Date
  paymentTypeId  String?       @map("payment_type_id")
  createdById    String        @map("created_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  paymentType PaymentType?     @relation(fields: [paymentTypeId], references: [id])
  createdBy   User             @relation(fields: [createdById], references: [id])
  payments    ExpensePayment[]

  @@index([date])
  @@index([paymentTypeId])
  @@index([status])
  @@map("expenses")
  @@schema("kassa")
}

model ExpensePayment {
  id            String   @id @default(cuid())
  expenseId     String   @map("expense_id")
  createdById   String   @map("created_by")
  paymentTypeId String   @map("payment_type_id")
  amount        Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now()) @map("created_at")

  expense     Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  createdBy   User        @relation(fields: [createdById], references: [id])
  paymentType PaymentType @relation(fields: [paymentTypeId], references: [id])

  @@index([expenseId, createdAt])
  @@index([createdAt])
  @@map("expense_payments")
  @@schema("kassa")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  details   String?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@map("audit_logs")
  @@schema("kassa")
}

model ClinicSettings {
  id        String   @id @default("default")
  name      String   @default("Gormonik Plus Klinik")
  address   String?
  phone     String?
  logoUrl   String?  @map("logo_url")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("clinic_settings")
  @@schema("kassa")
}
